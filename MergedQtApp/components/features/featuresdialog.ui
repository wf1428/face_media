  <property name="styleSheet">
   <string notr="true">/* Element-UI 风格样式 */
QDialog { 
    background-color: #f5f7fa; 
    border-radius: 8px;
}

/* 卡片样式 */
QWidget#mainCard { 
    background-color: white; 
    border-radius: 12px; 
    padding: 24px;
}

/* 标题样式 */
QLabel#titleLabel {
    color: #303133;
    font-size: 20px;
    font-weight: 600;
    margin-bottom: 20px;
}

/* 分组框样式 */
QGroupBox { 
    border: none; 
    margin-top: 0;
    background-color: transparent;
}

QGroupBox::title { 
    subcontrol-origin: margin; 
    left: 0; 
    top: 0; 
    padding: 0;
    background-color: transparent; 
    color: #606266; 
    font-size: 16px; 
    font-weight: 500; 
}

/* 复选框样式 */
QCheckBox { 
    spacing: 12px; 
    margin: 16px 0; 
    color: #606266; 
    font-size: 14px; 
}

QCheckBox::indicator { 
    width: 20px; 
    height: 20px; 
    border: 2px solid #dcdfe6; 
    border-radius: 4px; 
    background-color: white; 

}

QCheckBox::indicator:hover { 
    border-color: #409eff; 
}

QCheckBox::indicator:checked { 
    background-color: #409eff; 
    border-color: #409eff; 
    image: url(:/icons/check.png); 
}

/* 状态标签样式 */
QLabel#statusLabel { 
    color: #909399; 
    font-size: 14px; 
    margin: 16px 0; 
    padding: 12px; 
    background-color: #ecf5ff; 
    border: 1px solid #ebeef5; 
    border-radius: 6px;
}

/* 按钮样式 */
QPushButton { 
    padding: 12px 24px; 
    border: 1px solid #dcdfe6; 
    border-radius: 6px; 
    background-color: white; 
    color: #606266; 
    font-size: 14px; 
    font-weight: 500; 
    min-width: 120px;
}

QPushButton:hover { 
    border-color: #409eff; 
    background-color: #ecf5ff; 
    color: #409eff; 
}

QPushButton:pressed { 
    border-color: #337ecc; 
    background-color: #d9ecff; 
    color: #337ecc; 
}

QPushButton:default { 
    border-color: #409eff; 
    background-color: #409eff; 
    color: white; 
}

QPushButton:default:hover { 
    background-color: #66b1ff; 
    border-color: #66b1ff; 
}

QPushButton:default:pressed { 
    background-color: #337ecc; 
    border-color: #337ecc; 
}

/* 分割线样式 */
QFrame#divider { 
    height: 1px; 
    background-color: #ebeef5; 
    margin: 20px 0;
}</string>
