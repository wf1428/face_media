<RCC>
    <qresource prefix="/">
        <file>qml/EmbeddedVirtualKeyboard.qml</file>
    </qresource>
    <qresource prefix="/qss">
        <file alias="shadcn_dialog.qss">resources/qss/shadcn_dialog.qss</file>
        <file alias="admin_panel.qss">resources/qss/admin_panel.qss</file>
    </qresource>
    <qresource prefix="/icons/dialog">
        <file alias="info.svg">resources/icons/dialog/info.svg</file>
        <file alias="success.svg">resources/icons/dialog/success.svg</file>
        <file alias="warning.svg">resources/icons/dialog/warning.svg</file>
        <file alias="error.svg">resources/icons/dialog/error.svg</file>
        <file alias="question.svg">resources/icons/dialog/question.svg</file>
        <file alias="close.svg">resources/icons/dialog/close.svg</file>
    </qresource>
    <qresource prefix="/icons/nav">
        <file alias="device.svg">resources/icons/nav/device.svg</file>
        <file alias="users.svg">resources/icons/nav/users.svg</file>
        <file alias="logs.svg">resources/icons/nav/logs.svg</file>
        <file alias="sync.svg">resources/icons/nav/sync.svg</file>
        <file alias="tools.svg">resources/icons/nav/tools.svg</file>
        <file alias="settings.svg">resources/icons/nav/settings.svg</file>
    </qresource>
    <qresource prefix="/icons/info">
        <file alias="serial.svg">resources/icons/info/serial.svg</file>
        <file alias="ip.svg">resources/icons/info/ip.svg</file>
        <file alias="mac.svg">resources/icons/info/mac.svg</file>
        <file alias="version.svg">resources/icons/info/version.svg</file>
        <file alias="uptime.svg">resources/icons/info/uptime.svg</file>
        <file alias="people.svg">resources/icons/info/people.svg</file>
        <file alias="face.svg">resources/icons/info/face.svg</file>
        <file alias="logcount.svg">resources/icons/info/logcount.svg</file>
        <file alias="storage.svg">resources/icons/info/storage.svg</file>
        <file alias="cpu.svg">resources/icons/info/cpu.svg</file>
        <file alias="memory.svg">resources/icons/info/memory.svg</file>
        <file alias="temp.svg">resources/icons/info/temp.svg</file>
        <file alias="npu.svg">resources/icons/info/npu.svg</file>
    </qresource>
    <qresource prefix="/icons/action">
        <file alias="refresh.svg">resources/icons/action/refresh.svg</file>
        <file alias="edit.svg">resources/icons/action/edit.svg</file>
        <file alias="trash.svg">resources/icons/action/trash.svg</file>
        <file alias="upload.svg">resources/icons/action/upload.svg</file>
        <file alias="download.svg">resources/icons/action/download.svg</file>
        <file alias="save.svg">resources/icons/action/save.svg</file>
        <file alias="key.svg">resources/icons/action/key.svg</file>
        <file alias="clock.svg">resources/icons/action/clock.svg</file>
        <file alias="search.svg">resources/icons/action/search.svg</file>
        <file alias="check.svg">resources/icons/action/check.svg</file>
        <file alias="x.svg">resources/icons/action/x.svg</file>
        <file alias="lock.svg">resources/icons/action/lock.svg</file>
    </qresource>
</RCC>
