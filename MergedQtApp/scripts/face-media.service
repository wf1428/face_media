# @file face-media.service
# @brief 启动依赖 Weston 的应用监督脚本、驱动和 MQTT 子进程。
# @author Du lin
# @note 最近修改：2026-10-26；修改人：Du lin；显式设置 Qt 与 Weston 共用的运行目录，不持有或清理该目录；保留原服务顺序及监督策略。
[Unit]
Description=Face Media drivers, MQTT daemon and Qt application
Wants=network-online.target disable-console-blank.service weston-kiosk.service
After=network-online.target systemd-udev-settle.service disable-console-blank.service weston-kiosk.service
Before=udisk-watcher.service

[Service]
Type=simple
User=root
WorkingDirectory=/home/cat/face_media
Environment=XDG_RUNTIME_DIR=/run/face-media-wayland
Environment=APP_START_DELAY_SECONDS=5
Environment=APP_RESTART_DELAY_SECONDS=2
ExecStart=/usr/local/sbin/start_face_media.sh
Restart=always
RestartSec=5
KillMode=control-group
TimeoutStopSec=15
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
