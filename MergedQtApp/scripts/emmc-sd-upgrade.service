[Unit]
Description=RK3568 SD Boot Offline eMMC Upgrade (Retry Only)
After=local-fs.target systemd-udev-settle.service
Wants=systemd-udev-settle.service

# 升级服务必须先完成，业务/UI服务才能启动。
Before=network.target multi-user.target graphical.target
Before=face-media.service
Before=disable-console-blank.service
Before=udisk-watcher.service
Before=weston-kiosk.service

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/emmc-sd-upgrade.sh
TimeoutStartSec=0

StandardOutput=journal+console
StandardError=journal+console

[Install]
WantedBy=multi-user.target
