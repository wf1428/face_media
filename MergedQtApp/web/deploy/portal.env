# NetworkManager portal deployment settings; install root-owned, mode 0600.
# Leave auto to select an idle AP-capable WiFi interface. Never takes an uplink.
AP_INTERFACE=auto
AP_CONNECTION=yc-device-portal
AP_ADDRESS=192.168.10.1/24
# Existing profile passwords are preserved. A new profile needs a factory password.
AP_PASSWORD=88888888
QT_READY_FILE=/run/mergedqt/web-ready
QT_SOCKET=/run/mergedqt/web.sock
QT_WAIT_SECONDS=60
QT_STABLE_SECONDS=3
PORTAL_RUNTIME=/run/device-webd
PORTAL_CUSTOM_SSID=/home/cat/web-stage/portal-ssid
PORTAL_DNS_CONFIG=/etc/NetworkManager/dnsmasq-shared.d/91-portal-dns.conf
WEB_BINARY=/home/cat/web-stage/device-webd
WEB_CONFIG=/home/cat/web-stage/web.json
