# @file device-hotspot.service
# @brief 独立 AP/DHCP 进程；接口须支持 AP 且由本服务专用，非 Qt 内置网络业务。
# @author Du lin
# @date 2026-10-09
[Unit]
Description=Device dedicated local WiFi hotspot
After=network.target

[Service]
Type=simple
EnvironmentFile=/home/cat/web-stage/hotspot.env
ExecStart=/home/cat/web-stage/hotspot-start.sh
Restart=on-failure
RestartSec=5
KillMode=control-group
RuntimeDirectory=device-hotspot
RuntimeDirectoryMode=0750

[Install]
WantedBy=multi-user.target
