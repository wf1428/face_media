# @file device-webd.service
# @brief Qt 稳定后启动可选 NetworkManager 热点和 Web；失败不影响 Qt。
# @author Du lin
# @date 2026-10-09

[Unit]
Description=Optional NetworkManager hotspot and local Web portal
After=face-media.service NetworkManager.service
Wants=NetworkManager.service
StartLimitIntervalSec=180
StartLimitBurst=3

[Service]
Type=simple
User=root
Group=root
ExecStart=/home/cat/web-stage/device-web-start.sh
ExecReload=/home/cat/web-stage/portal-network.sh refresh
Restart=on-failure
RestartSec=10
TimeoutStopSec=45
TimeoutStartSec=45
KillSignal=SIGTERM
UMask=0027
RuntimeDirectory=device-webd
RuntimeDirectoryMode=0750
StandardOutput=journal
StandardError=journal
LimitNOFILE=128

# 仅对新 daemon 设置资源上限；Qt 原识别/播放服务不受此值影响。
MemoryMax=128M
TasksMax=32

[Install]
WantedBy=multi-user.target
