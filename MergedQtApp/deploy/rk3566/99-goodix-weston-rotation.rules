# Map the Goodix touchscreen to the DSI output. The helper prints an identity
# matrix for 0/180 degrees and a 180-degree correction for 90/270 degrees.
ACTION!="remove", SUBSYSTEM=="input", KERNEL=="event[0-9]*", ATTRS{name}=="Goodix Capacitive TouchScreen", ENV{WL_OUTPUT}="DSI-1", PROGRAM="/usr/local/sbin/weston-control touch-matrix", ENV{LIBINPUT_CALIBRATION_MATRIX}="%c"
