[Unit]
Description=USB disk media copy watcher for RK3566/RK3568
Wants=disable-console-blank.service weston-kiosk.service face-media.service
After=local-fs.target systemd-user-sessions.service disable-console-blank.service weston-kiosk.service face-media.service
StartLimitIntervalSec=0

[Service]
Type=simple
ExecStart=/bin/sh /usr/local/sbin/udisk_watcher.sh run
Restart=always
RestartSec=2
KillSignal=SIGTERM
TimeoutStopSec=10

[Install]
WantedBy=multi-user.target
