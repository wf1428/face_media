[paths]
storage_root=/mnt/UDISK
static_root=/mnt/UDISK/res/static
video_dir=/mnt/UDISK/res/static/demoResources/images/video
database=/var/lib/qt_ycest/demo.db

[hardware]
signal_board_uart=/dev/ttyS5
qr_uart=/dev/ttyS6
card_uart=/dev/ttyS2
rs485_uart=/dev/ttyS8
rtc_device=/dev/rtc0
# 必须根据 /proc/bus/input/devices 或 /dev/input/by-path 配置
key_device=

[card_reader]
# true：读头心跳超时后每30秒打印一次错误；false：关闭该日志，界面提示仍保留
heartbeat_log_enabled=true

[gstreamer]
# EGLFS 正式模式由 Qt OpenGL 画布显示视频；保持为空以使用 appsink。
video_sink=
audio_sink=alsasink

[audio]
card=0
device=plughw:CARD=rockchiprk809co,DEV=0
# RK809 原始播放音量控制项；应用内部使用 cset numid=3
mixer_control=numid=3
# 仅在板级驱动提供功放控制字符设备时填写
amp_device=
