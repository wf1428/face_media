+#include "AppShell.h"
+
+#include "DebugMousePresenceSensor.h"
+#include "ModeController.h"
+#include "components/cursoroverlay/CursorOverlay.h"
+#include "modules/facegate/FaceGateModuleAdapter.h"
+#include "modules/multimedia/MultimediaModuleAdapter.h"
+
+#include <QCoreApplication>
+#include <QDebug>
+#include <QDir>
+#include <QFileInfo>
+#include <QResizeEvent>
+#include <QSettings>
+#include <QStackedWidget>
+#include <QTimer>
+#include <QVBoxLayout>
+
+AppShell::AppShell(QWidget *parent)
+    : QWidget(parent)
+{
+    setObjectName(QStringLiteral("appShellRoot"));
+    setWindowFlags(Qt::FramelessWindowHint);
+    setAttribute(Qt::WA_StyledBackground, true);
+    setStyleSheet(QStringLiteral("#appShellRoot { background: black; }"));
+
+    auto *layout = new QVBoxLayout(this);
+    layout->setContentsMargins(0, 0, 0, 0);
+    layout->setSpacing(0);
+    stack_ = new QStackedWidget(this);
+    stack_->setObjectName(QStringLiteral("moduleStack"));
+    layout->addWidget(stack_);
+}
+
+AppShell::~AppShell()
+{
+    shutdown();
+}
+
+bool AppShell::initialize()
+{
+    if (initialized_) {
+        return true;
+    }
+
+    QSettings settings(shellConfigPath(), QSettings::IniFormat);
+#if QT_VERSION < QT_VERSION_CHECK(6, 0, 0)
+    settings.setIniCodec("UTF-8");
+#endif
+    const QString initialMode =
+        settings.value(QStringLiteral("application/initialMode"), QStringLiteral("multimedia"))
+            .toString().trimmed().toLower();
+    const QString presenceDriver =
+        settings.value(QStringLiteral("modeSwitch/presenceDriver"), QStringLiteral("debug_mouse"))
+            .toString().trimmed().toLower();
+    const bool leftHoldEnabled =
+        settings.value(QStringLiteral("modeSwitch/debugLeftHold"), true).toBool();
+    const int leftHoldDurationMs =
+        settings.value(QStringLiteral("modeSwitch/leftHoldDurationMs"), 3000).toInt();
+    const bool cursorEnabled =
+        settings.value(QStringLiteral("cursor/enabled"), true).toBool();
+
+    if (initialMode != QStringLiteral("multimedia")) {
+        qWarning() << "[SHELL] unsupported initialMode; forcing multimedia" << initialMode;
+    }
+    if (presenceDriver != QStringLiteral("debug_mouse")) {
+        qCritical() << "[SHELL] unsupported presence driver" << presenceDriver;
+        return false;
+    }
+
+    multimediaModule_ = new MultimediaModuleAdapter(stack_, this);
+    faceGateModule_ = new FaceGateModuleAdapter(stack_, faceGateConfigPath(), this);
+    if (!multimediaModule_->initialize() || !faceGateModule_->initialize()) {
+        qCritical() << "[SHELL] module initialization failed";
+        return false;
+    }
+
+    stack_->addWidget(multimediaModule_->rootWidget());
+    stack_->addWidget(faceGateModule_->rootWidget());
+
+    // CursorOverlay is the sole cursor instance for both business modules.
+    cursor_ = new CursorOverlay(this);
+    cursor_->setOverlayEnabled(cursorEnabled);
+    modeController_ = new ModeController(stack_,
+                                         multimediaModule_,
+                                         faceGateModule_,
+                                         cursor_,
+                                         this);
+    presenceSensor_ = new DebugMousePresenceSensor(multimediaModule_->rootWidget(),
+                                                   leftHoldEnabled,
+                                                   leftHoldDurationMs,
+                                                   this);
+
+    connect(presenceSensor_, &DebugMousePresenceSensor::presenceDetected,
+            modeController_, &ModeController::handlePresenceDetected);
+    connect(presenceSensor_, &DebugMousePresenceSensor::presenceLost,
+            modeController_, &ModeController::handlePresenceLost);
+    connect(presenceSensor_, &DebugMousePresenceSensor::sensorFault,
+            this, [](const QString &message) {
+                qWarning() << "[PRESENCE] fault" << message;
+            });
+    connect(modeController_, &ModeController::stateChanged,
+            this, [this](ModeController::AppModeState state) {
+                if (presenceSensor_) {
+                    presenceSensor_->setMultimediaActive(
+                        state == ModeController::AppModeState::MultimediaActive);
+                }
+                raiseCursorOverlay();
+            });
+    connect(modeController_, &ModeController::switchFailed,
+            this, [](const QString &message) {
+                qWarning() << "[MODE] switch failed" << message;
+            });
+
+    if (!modeController_->start() || !presenceSensor_->start()) {
+        shutdown();
+        return false;
+    }
+    presenceSensor_->setMultimediaActive(true);
+
+    initialized_ = true;
+    shutdown_ = false;
+    qInfo() << "[SHELL] initialized"
+            << "config=" << shellConfigPath()
+            << "presenceDriver=" << presenceDriver
+            << "cursorEnabled=" << cursorEnabled
+            << "facegateConfig=" << faceGateConfigPath();
+    raiseCursorOverlay();
+    return true;
+}
+
+void AppShell::shutdown()
+{
+    if (shutdown_) {
+        return;
+    }
+    shutdown_ = true;
+    if (presenceSensor_) {
+        presenceSensor_->stop();
+    }
+    if (modeController_) {
+        modeController_->shutdown();
+    }
+    initialized_ = false;
+    qInfo() << "[SHELL] shutdown complete";
+}
+
+QWidget *AppShell::multimediaRootWidget() const
+{
+    return multimediaModule_ ? multimediaModule_->rootWidget() : nullptr;
+}
+
+void AppShell::simulatePresenceLost()
+{
+    if (presenceSensor_) {
+        presenceSensor_->simulatePresenceLost();
+    }
+}
+
+void AppShell::raiseCursorOverlay()
+{
+    QTimer::singleShot(0, this, [this]() {
+        if (cursor_) {
+            cursor_->raise();
+        }
+    });
+}
+
+void AppShell::resizeEvent(QResizeEvent *event)
+{
+    QWidget::resizeEvent(event);
+    if (cursor_) {
+        cursor_->raise();
+    }
+}
+
+QString AppShell::shellConfigPath() const
+{
+    const QByteArray overridePath = qgetenv("APP_SHELL_CONFIG");
+    if (!overridePath.trimmed().isEmpty()) {
+        return QString::fromLocal8Bit(overridePath);
+    }
+    const QString appDir = QCoreApplication::applicationDirPath();
+    const QString deployed = QDir(appDir).filePath(QStringLiteral("app_shell.ini"));
+    if (QFileInfo::exists(deployed)) {
+        return deployed;
+    }
+    const QString appConfig = QDir(appDir).filePath(QStringLiteral("config/app_shell.ini"));
+    if (QFileInfo::exists(appConfig)) {
+        return appConfig;
+    }
+    return QDir::current().filePath(QStringLiteral("config/app_shell.ini"));
+}
+
+QString AppShell::faceGateConfigPath() const
+{
+    const QByteArray overridePath = qgetenv("FACEGATE_CONFIG");
+    if (!overridePath.trimmed().isEmpty()) {
+        return QString::fromLocal8Bit(overridePath);
+    }
+    const QString appDir = QCoreApplication::applicationDirPath();
+    const QString deployed = QDir(appDir).filePath(QStringLiteral("facegate.ini"));
+    if (QFileInfo::exists(deployed)) {
+        return deployed;
+    }
+    const QString appModuleConfig =
+        QDir(appDir).filePath(QStringLiteral("modules/facegate/FaceGateQt/config/facegate.ini"));
+    if (QFileInfo::exists(appModuleConfig)) {
+        return appModuleConfig;
+    }
+    const QString currentConfig = QDir::current().filePath(QStringLiteral("facegate.ini"));
+    if (QFileInfo::exists(currentConfig)) {
+        return currentConfig;
+    }
+    return QDir::current().filePath(
+        QStringLiteral("modules/facegate/FaceGateQt/config/facegate.ini"));
+}
